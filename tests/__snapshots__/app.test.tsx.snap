exports[`sidebar placement > Machine Tabs list: after its search, above Last 5 1`] = `"<div data-sidebar="sidebar"><div data-sidebar="content"><div id="mt-root"><div class="machine-tabs-search">search</div><div data-agent-roster-block="" data-bb-plugin="agent-roster" data-layout="machine-tabs"></div><div data-machine-tabs-list="" data-machine-tabs-recent="" id="recent">Last 5</div><div data-machine-tabs-list="" id="list">rows</div></div></div></div>"`;

exports[`sidebar placement > bb's own list: the block goes first in the list area, under the navigation search 1`] = `"<div data-sidebar="sidebar"><nav>Search threads</nav><div data-sidebar="content"><div data-agent-roster-block="" data-bb-plugin="agent-roster" data-layout="standard"></div><div id="bb-list">thread rows</div></div></div>"`;
